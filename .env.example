# ─────────────────────────────────────────────────────────────────────────────
# TISC Testing: environment variables
# Database: Neon Postgres (free tier)
#
# In Vercel: Project → Settings → Environment Variables
# Locally:   copy this file to .env.local and fill it in
# ─────────────────────────────────────────────────────────────────────────────

# ── Set these in VERCEL ──────────────────────────────────────────────────────

# Neon connection string. Use the POOLED one (host contains "-pooler").
# If you add Neon through Vercel → Storage / Marketplace, Vercel creates
# DATABASE_URL for you automatically, so you don't need to add it by hand.
# Example: postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random secret used to sign login cookies. Generate one with:  openssl rand -hex 32
# Changing it logs everyone out.
SESSION_SECRET=

# Optional. "true" lets people create their own account (always as a Novice).
# Leave "false" if only admins should create accounts.
ALLOW_SIGNUP=false


# ── Only needed on YOUR MACHINE, once, for `npm run db:setup` ────────────────
# That command creates the tables in Neon and this first admin login.
# These do NOT need to be in Vercel.

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
